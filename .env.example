# --- Database -------------------------------------------------------------
# Local: SQLite file. Prod: Supabase Postgres (run `npm run schema:postgres`).
DATABASE_URL="file:./dev.db"
# DIRECT_URL is only used by the Postgres schema (Supabase direct connection).
# DIRECT_URL=""

# --- App ------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
# Force mocks even when keys are present (handy for rehearsing the demo offline).
# MOCK_MODE=1

# --- LLM (phase 3) --------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- Speech (phase 5) -----------------------------------------------------
SARVAM_API_KEY=""

# --- Nutrition fallback (phase 2) -----------------------------------------
# USDA FoodData Central. DEMO_KEY works for light dev use.
USDA_FDC_API_KEY=""

# --- WhatsApp Cloud API (phase 5, optional) ------------------------------
CHANNEL_WHATSAPP=0
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
